<odoo>

    <record id="view_helpdesk_sla_list"
            model="ir.ui.view">
        <field name="name">helpdesk.sla.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch"
               type="xml">
            <list>
                <field name="name" />
                <field name="priority" />
                <field name="response_time" />
                <field name="resolution_time" />
            </list>
        </field>
    </record>


        <record id="action_helpdesk_sla"
                model="ir.actions.act_window">
            <field name="name">SLA</field>
            <field name="res_model">helpdesk.sla</field>
            <field name="view_mode">list,form</field>
            <!-- <field name="search_view_id"
                   ref="view_helpdesk_sla_search" /> -->
        </record>

    <menuitem id="menu_helpdesk_sla"
              name="SLA"
              parent="menu_helpdesk"
              action="action_helpdesk_sla" />

</odoo>