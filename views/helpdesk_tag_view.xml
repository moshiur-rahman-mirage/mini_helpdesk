<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_helpdesk_tag_list"
            model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch"
               type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="view_helpdesk_tag_form"
            model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch"
               type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_helpdesk_tag"
            model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
    </record>
   <menuitem id="menu_helpdesk_tag"
             name="Tags"
             parent="menu_helpdesk"
             action="action_helpdesk_tag" />
</odoo>