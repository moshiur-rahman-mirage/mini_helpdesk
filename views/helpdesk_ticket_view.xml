<odoo>
    <record id="view_helpdesk_ticket_list"
            model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch"
               type="xml">
            <list>
                <field name="name" />
                <field name="team_id" />
                <field name="user_id" />
                <field name="stage_id" />
                <field name="customer_id" />
                <field name="priority" />
            </list>
        </field>
    </record>

<record id="view_helpdesk_ticket_form"
        model="ir.ui.view">
    <field name="name">helpdesk.ticket.form</field>
    <field name="model">helpdesk.ticket</field>
    <field name="arch"
           type="xml">
        <form>
            <!-- Hidden workflow fields -->
            <field name="stage_is_new"
                   invisible="1" />
            <field name="stage_is_in_progress"
                   invisible="1" />
            <field name="stage_is_resolved"
                   invisible="1" />
            <!-- Actions -->
            <header>
                <button name="action_start_progress"
                        string="Start Progress"
                        type="object"
                        class="btn-primary"
                        invisible="not stage_is_new" />
                <button name="action_resolve"
                        string="Resolve"
                        type="object"
                        class="btn-primary"
                        invisible="not stage_is_in_progress" />
                <button name="action_close"
                        string="Close"
                        type="object"
                        class="btn-primary"
                        invisible="not stage_is_resolved" />
            </header>
            <sheet>
                <!-- Main Information -->
                <group col="3">
                    <!-- Left Column -->
                    <group string="Ticket Information">
                        <field name="ticket_no"
                               readonly="1" />
                        <field name="name" />
                        <field name="team_id" />
                        <field name="team_leader_id"
                               readonly="1" />
                        <field name="user_id"
                               domain="[('id', 'in', team_user_ids)]" />
                        <field name="stage_id" />
                    </group>
                    <!-- Right Column -->
                    <group string="Assignment ">
                        <field name="customer_id" />
                        <field name="priority" />

                        <!-- Technical field used by user_id domain -->
                        <field name="team_user_ids"
                               invisible="1" />
                        </group>
                        <group string="SLA">
                            <field name="sla_id" />
                            <field name="response_deadline"
                                   readonly="1" />
                            <field name="response_date" />
                            <field name="resolution_deadline"
                                   readonly="1" />
                            <field name="response_sla_status"
                                   readonly="1" />
                            <field name="resolution_date" />
                            <field name="resolution_sla_status"
                                   readonly="1" />
                        </group>
                        </group>
                        <!-- Description -->
                        <group string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Describe the issue..." />
                        </group>
                        <!-- Tags -->
                        <group string="Tags">
                            <field name="tag_ids"
                           widget="many2many_tags"
                           nolabel="1" />
                           </group>
                           </sheet>
                           <chatter>
                               <field name="activity_ids" />
                           </chatter>
                           </form>
                           </field>
                           </record>

    <record id="view_helpdesk_ticket_search"
            model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch"
               type="xml">
            <search>
                <field name="name" />
                <field name="ticket_no" />
                <field name="customer_id" />
                <field name="user_id" />
                <separator />
                <filter name="urgent_tickets"
                        string="Urgent"
                        domain="[('priority', '=', 'urgent')]" />
                <filter name="urgent_in_progress"
                        string="Urgent In Progress"
                        domain="[
                    ('priority', '=', 'urgent'),
                    ('stage_id.name', '=', 'In Progress')
                ]" />
                <filter name="resolved"
                        string="Resolved"
                        domain = "[
                        ('stage_id.name','=','Resolved')
                        ]" />
                <filter name="urgent_or_high"
                        string="Urgent or High"
                        domain="[
                    '|',
                    ('priority', '=', 'urgent'),
                    ('priority', '=', 'high')
                ]" />
                <filter name="active_important"
                        string="Important Active"
                        domain="[
                            '|',
                            '!',
                            ('priority', '=', 'urgent'),
                            ('priority', '=', 'high'),
                        ('stage_id.name', '=', 'Resolved')
                        ]" />
                <group>
                    <filter name="group_by_priority"
                            string="Priority"
                            context="{'group_by': 'priority'}" />
                    <filter name="group_by_stage"
                            string="Stage"
                            context="{'group_by': 'stage_id'}" />
                    <filter name="group_by_team"
                            string="Team"
                            context="{'group_by': 'team_id'}" />
                    <filter name="group_by_user"
                            string="User"
                            context="{'group_by':'user_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_helpdesk_ticket"
            model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_helpdesk_ticket_search" />
    </record>
<record id="action_helpdesk_urgent_tickets"
        model="ir.actions.act_window">
    <field name="name">Urgent Tickets</field>
    <field name="res_model">helpdesk.ticket</field>
    <field name="view_mode">list,form</field>
    <field name="context">
        {'search_default_urgent_tickets': 1}
    </field>
</record>
    <menuitem id="menu_helpdesk_ticket"
              name="Tickets"
              parent="menu_helpdesk"
              action="action_helpdesk_ticket" />
    <menuitem id="menu_helpdesk_urgent_tickets"
              name="Urgent Tickets"
              parent="menu_helpdesk"
              action="action_helpdesk_urgent_tickets"
              sequence="20" />
</odoo>